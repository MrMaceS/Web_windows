
ENVIRONMENT=development

# --- База данных ---
# Локально можно временно использовать sqlite:///./leads.db,postgresql+psycopg2://window_user:window_pass@localhost:5432/window_landing
# но продовый вариант — Postgres (поднимается через docker-compose):
DATABASE_URL=sqlite:///./leads.db
POSTGRES_USER=window_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=window_landing

# --- Telegram-бот для уведомлений о заявках ---
# 1. Создайте бота через @BotFather, получите токен
# 2. Добавьте бота в чат/группу менеджеров
# 3. Узнайте chat_id (см. README → "Как получить TELEGRAM_CHAT_ID")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

RATE_LIMIT_LEAD=5/minute
RATE_LIMIT_ESTIMATE=30/minute


COMPANY_REGION=Москва и область
COMPANY_WORK_HOURS=Пн–Вс, 9:00–21:00
WHATSAPP_LINK=
TELEGRAM_LINK=
LEGAL_ENTITY_NAME=

YANDEX_METRIKA_ID=

REDIS_URL=
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_RETRY_BACKOFF_SECONDS=60

ADMIN_SESSION_SECRET=dev-insecure-secret-change-me
ADMIN_SESSION_MAX_AGE_SECONDS=28800

PRIVACY_POLICY_URL=/privacy
CONSENT_TEXT=Согласен(на) на обработку персональных данных в соответствии с политикой конфиденциальности
